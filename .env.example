# Copy to .env.local for development, and set the same keys in your host's
# environment settings for production.

# Absolute origin of the deployed site, used for canonical, Open Graph, sitemap
# and robots URLs.
#
# OPTIONAL ON VERCEL. The build falls back to VERCEL_PROJECT_PRODUCTION_URL,
# which Vercel sets automatically and which always points at the production
# domain even from a preview deployment. Only set this to override, for example
# a custom domain that is not the shortest one Vercel would pick.
#
# Falls back to http://localhost:3000 elsewhere.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Where /resume redirects to. Print it with `npm run resume:publish`.
#
# The PDF is deliberately not committed: it is updated often, and git stores
# every revision of a binary in full. It lives in Vercel Blob under a fixed
# pathname instead, so this URL is stable and only needs setting once.
#
# Must be an absolute URL. If unset, /resume returns 503 rather than breaking
# the build.
RESUME_URL=https://xxxxxxxx.public.blob.vercel-storage.com/resume/chintan-bhara-resume.pdf

# Read/write token for the Vercel Blob store, used only by
# `npm run resume:publish`. The running site never needs it: it just redirects.
#
# Get it from the Vercel dashboard under Storage > your Blob store > Tokens, or
# by running `vercel env pull .env.local` on a linked project.
#
# This is a secret. .env.local is gitignored; keep it that way.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
